{
  "version": 2,
  "buildCommand": "prisma generate && tsc",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  }
}
