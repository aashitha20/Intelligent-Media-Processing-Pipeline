NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://media:media@localhost:5432/media_pipeline?schema=public
REDIS_URL=redis://127.0.0.1:6379
UPLOAD_DIR=./uploads
LOG_LEVEL=info
BLUR_THRESHOLD=100
BRIGHTNESS_MIN=40
BRIGHTNESS_MAX=220
MIN_WIDTH=640
MIN_HEIGHT=480
# queue = BullMQ worker (local). inline = process in API (required on Vercel)
PROCESSING_MODE=queue
